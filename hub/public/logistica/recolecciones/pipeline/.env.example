# Plantilla — copiar a .env y llenar. El .env real está gitignored.

# LocationIQ — https://locationiq.com (token por dashboard)
LIQ_KEY=

# Lupap — geocodificador de Bogotá — https://developer.lupap.com (registro: key + secret)
LUPAP_KEY=
LUPAP_SECRET=

# Pausa entre requests (ms)
PAUSA=700

# Supabase — para la carga inicial (seed-supabase.js). Se leen de hub/.env.local:
#   cd hub && node --env-file=.env.local public/logistica/recolecciones/pipeline/seed-supabase.js
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
