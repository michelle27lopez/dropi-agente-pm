# ── Supabase ──────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Google Drive ──────────────────────────────────────
GOOGLE_DRIVE_FOLDER_ID=your-folder-id-from-drive-url
GOOGLE_SERVICE_ACCOUNT_JSON=path/to/service-account-credentials.json

# ── JIRA (Atlassian Cloud) ────────────────────────────
JIRA_BASE_URL=https://dropi.atlassian.net
JIRA_EMAIL=your-email@dropi.com
JIRA_API_TOKEN=your-atlassian-api-token
JIRA_PROJECT_KEY=DROPI

# ── Confluence ────────────────────────────────────────
CONFLUENCE_BASE_URL=https://dropi.atlassian.net/wiki
CONFLUENCE_SPACE_KEY=PROD

# ── Optional ──────────────────────────────────────────
BOOTSTRAP_REPORT_PATH=logs/bootstrap_report.md
